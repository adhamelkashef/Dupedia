+
+/* ---------------- rules ---------------- */
+test("triage: a trigger next to a relevant word is a signal; the quote is a sentence of the item", () => {
+  const r = S.triage({ title: "Landscaping news", text: `${EN_NOISE} ${EN_AWARD}` }, null);
