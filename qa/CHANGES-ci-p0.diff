+  assert.equal(await kv(e, `ru:ai:compat:d:${new Date().toISOString().slice(0, 10)}`), 1);
+  const log = await docs(e, "mix/ailog/l");
+  assert.equal(log.length, 1); assert.equal(log[0].provider, "compat"); assert.equal(log[0].ok, true);
