+  const STAGE_KEYS = STAGES.map((s) => s[0]);
+  const stageOf = (v) => { const s = String(v || "").trim().toLowerCase(); return STAGES.find(([k, l]) => k === s || l.toLowerCase() === s) ? STAGES.find(([k, l]) => k === s || l.toLowerCase() === s)[0] : "unknown"; };
