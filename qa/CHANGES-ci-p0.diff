+  assert.equal(bad.tasks.extract.provider, "gemini"); assert.equal(bad.providers.gemini.model, "xscript"); assert.equal(bad.providers.claude.dailyCalls, 0);
+});
+
+/* ---------------- the router: switch off = the old Gemini call ---------------- */
